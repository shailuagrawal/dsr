    public function dsr(Request $request)
    {

        if(isset($request->Delete) && $request->Delete=='Delete'){
            if(count($request->deldsr)>0){
                $a = Dsr::whereIn('id', $request->deldsr)->delete();
            }
        }
        
        $finalResult = [];
        $finalResultTotal = [];
        $grossTarget = [];
        //
        $projects = Project::all()->sortBy("project_name");
        $requestData = [];
        $requestData['project_id'] = isset($request->project_id) ? $request->project_id : null;
        $requestData['groupBy'] = isset($request->groupBy) ? $request->groupBy : null;
        $requestData['fromDate'] = isset($request->fromDate) ? $request->fromDate : null;
        $requestData['toDate'] = isset($request->toDate) ? $request->toDate : null;
        
        
        $allProjects = [];
        foreach($projects as $project){
            $allProjects[$project->id] = $project->project_name;
        }
        $groupBy = ['created_at'=>'Date','user_id'=>'Employee']; 
        
        
        
        
        
        if($requestData['project_id']!==null){
            $dsrsObj = Dsr::with(['project','user'])->where('project_id', '=', $requestData['project_id']);

            if($requestData['fromDate']!=null){
                $dsrsObj = $dsrsObj->where('created_at', '>=', $requestData['fromDate']);
            }
            
            if($requestData['toDate']!=null){
                $dsrsObj = $dsrsObj->where('created_at', '<=', $requestData['toDate']);
            }
            
            if($requestData['groupBy']!==null){
                $dsrsObj = $dsrsObj->orderby($requestData['groupBy'],'desc')->get();
            }

            
            $total = [];
            $calTarget = [];
            foreach($dsrsObj as $key => $dsr){
                $aDsr = [];
                $heading = [];
                                
                if($requestData['groupBy']=='created_at'){    
                    $sortBy = date('Y-m-d', strtotime($dsr->created_at));
                }else{
                    $sortBy = $dsr->user->id;
                }
                
                $aDsr['id'] = $dsr->id;
                $aDsr['emp_name'] = "{$dsr->user->first_name} {$dsr->user->last_name}";
                $heading['emp_name'] = 'Employee Name';
                $total[$sortBy]['emp_name'] = ''; 
                
                $aDsr['dateTime'] = date('F j, Y, g:i a', strtotime($dsr->created_at));;
                $heading['dateTime'] = 'Date and Time';
                $total[$sortBy]['dateTime'] = '';
                                
                $aDsr['send_at'] = date('g:i a', strtotime($dsr->created_at));
                $heading['send_at'] = 'Sent DSR At';
                $total[$sortBy]['send_at'] = '';
                                
                $aDsr['hours'] = date('G:i', mktime(0, $dsr->minutes));
                $heading['hours'] = 'Hours Worked';
                if(isset($total[$sortBy]['hours'])){
                    $total[$sortBy]['hours'] = $total[$sortBy]['hours'] + $dsr->minutes;
                }else{
                    $total[$sortBy]['hours'] = $dsr->minutes;
                }
                                
                $fields = Project::getDsrFields($dsr->project->message);
                $dsrInfo = unserialize($dsr->details);
                
                //echo'<pre>';
                //print_r($fields);
                //echo'</pre>';
                
                //echo'<pre>';
                //print_r($dsrInfo);
                //echo'</pre>';
                //exit;
                
                foreach($fields as $f){
                    
                    if(isset($f['field'])){
                        if(isset($f['target'])){
                            $target = "/ {$f['target']}";
                            if(isset($calTarget[$sortBy][$f['field']])){
                                $calTarget[$sortBy][$f['field']] = $calTarget[$sortBy][$f['field']] + $f['target'];
                            }else{
                                $calTarget[$sortBy][$f['field']] = $f['target'];
                            }
                        }else{
                            $target = '';
                        }
                        $aDsr[$f['field']] = isset($dsrInfo[$f['field']]) ? "{$dsrInfo[$f['field']]} {$target}" : '';
                        $heading[$f['field']] = $f['title'];
                        
                        if($f['type']=='number'){
                            if(isset($total[$sortBy][$f['field']])){
                                if(isset($dsrInfo[$f['field']])){
                                    $total[$sortBy][$f['field']] = $total[$sortBy][$f['field']] + $dsrInfo[$f['field']];
                                }
                            }else{
                                if(isset($dsrInfo[$f['field']])){    
                                    $total[$sortBy][$f['field']] = $dsrInfo[$f['field']];
                                }else{
                                    $total[$sortBy][$f['field']] = 0;
                                }
                            }
                        }else{
                            $total[$sortBy][$f['field']] = '';
                        }
                    }
                    
                }
                
                $finalResult[$sortBy][] = $aDsr;
                $finalResultTotal[$sortBy] = $total[$sortBy];
                @$grossTarget[$sortBy] = $calTarget[$sortBy];
            }
        }
        
        

		//************Grant Total**********************	        
        $GrantResultTotal = array();
        foreach($finalResultTotal as $sortKey => $ResultTotal ){
			foreach($ResultTotal as $fieldKey => $aField){
				if(is_numeric($aField)){
					if(isset($GrantResultTotal[$fieldKey])){
						$GrantResultTotal[$fieldKey] = $GrantResultTotal[$fieldKey] + $aField;
					}else{
						$GrantResultTotal[$fieldKey] = $aField;
					}
				}else{
					$GrantResultTotal[$fieldKey] = '';
				}
			}
		}
        //************Grant Total**********************
        //exit;
        
        return view('admin.dsr',compact('allProjects','groupBy','requestData','finalResult','heading','finalResultTotal','grossTarget', 'GrantResultTotal'));
    }
    
    

    
    public function leaveupdate(Request $request){
        /*
        $response = array(
            'status' => 'success'
        );
        return response()->json($response);
        */ 
        //------------------------
        
        
        if(is_array($request->leave_id)){
            $allLeaves = [];
            foreach($request->leave_id as $key => $aLeave){
                $allLeaves[$key]['leave_id'] = $aLeave;
                $allLeaves[$key]['actiontaken'] = $request->actiontaken;
            }
        }else{
            $allLeaves = [];
            $allLeaves[0]['leave_id'] = $request->leave_id;
            $allLeaves[0]['comment'] = $request->comment;
            $allLeaves[0]['actiontaken'] = $request->actiontaken;
        }
        
        //dd($allLeaves);
        
        foreach($allLeaves as $aleave){
            $finalStatus = -1;
            $user = Auth::user();
            $leave = Leave_approval::with('leave')->where('leave_id','=',$aleave['leave_id'])->where('manager_id','=',$user->id)->first();
            
            if($leave!=NULL){
                $leave->approved = $aleave['actiontaken'];
                if(isset($aleave['comment'])){
                    $leave->comment = $aleave['comment'];
                }
                $leave->save();
            }
            
            $leavesManager = Leave_approval::with('leave','allManagers')->where('leave_id','=',$aleave['leave_id'])->get();
            
            
            // 0-pending, 1-in process, 2-approved, 3-rejected, 4 cancelled
            $statusFromAllManagers = [];
            $chk4approved = true;
            foreach($leavesManager as $leavesMan){
                if($leavesMan->approved!=2){
                    $chk4approved = false;
                }
                $statusFromAllManagers[] = $leavesMan->approved;
            }
            
            
            if(in_array(3, $statusFromAllManagers)){
                $finalStatus =  3;
            }elseif(in_array(4, $statusFromAllManagers)){
                $finalStatus =  4;
            }elseif(in_array(2, $statusFromAllManagers)){
                $finalStatus =  1;
            }
            
            if($chk4approved==true){
                $finalStatus =  2;
            }
            
    
            
            if($finalStatus>0){
                $finalLeave = Leaves::findOrFail($aleave['leave_id']);
                $finalLeave->status = $finalStatus;
                $finalLeave->save();
            }
        }
        
        if($request->isAjaxCall){
            return 1;
        }
        
        if($request->fromPendingLeavPage==1){
            return redirect('leave/requests');
        }
        
        if($request->fromDashboard==1){
            return redirect('admin/dashboard');
        }
        
        return redirect('leave/browse');
    }
    
    

    public function leaverequests(){
        
        $user = Auth::user();
        $leavesObj = Leave_approval::with('employee', 'leave','allManagers')->where('approved','<',2)->where('manager_id','=',$user->id)->orderby('created_at','desc')->get();
        
        
        $Leave_categories = Leave_categories::all();
        
        $allCategories = [];
        foreach($Leave_categories as $Leave_category){
            $allCategories[$Leave_category->id] =$Leave_category->category_name;
        }
       // dd($allCategories);
        //dd($leavesObj);

        $data = [];
        
        
        
        foreach($leavesObj as $k => $aLeave){
        
            $data[$k]['leave_approval_id'] = $aLeave->id;
            
                $data[$k]['leave_id'] = $aLeave->leave->id;
            
            foreach($aLeave->employee as $emp){
                
                //dd($emp);
                $data[$k]['user_id'] = $aLeave->leave->user_id;
                $data[$k]['name'] = "$emp->first_name $emp->last_name";
                $data[$k]['created_at'] = date('F j, Y, g:i a', strtotime($aLeave->leave->created_at));
                $data[$k]['leave_from'] = date('F j, Y', strtotime($aLeave->leave->leave_from));
                $data[$k]['leave_to'] = date('F j, Y', strtotime($aLeave->leave->leave_to));
                $data[$k]['no_working_days'] = $aLeave->leave->no_working_days;

                switch ($aLeave->leave->status) {
                    case 0:
                        $data[$k]['status'] = 'Pending';
                        break;
                    case 1:
                        $data[$k]['status'] = 'In Process';
                        break;
                    case 2:
                        $data[$k]['status'] = 'Approved';
                        break;
                    case 3:
                        $data[$k]['status'] = 'Rejected';
                        break;
                    case 4:
                        $data[$k]['status'] = 'Cancelled';
                        break;
                    default:
                        $data[$k]['status'] = 'Pending';
                }
                $data[$k]['status_key'] = $aLeave->leave->status;
                $data[$k]['category'] = $allCategories[$aLeave->leave->leave_category_id];
                $data[$k]['type'] = $aLeave->leave->leave_type > 0 ? 'Pre' : 'Post';
                
                
                $data[$k]['remark'] = '';
                
            }            
  
        }
        
//         echo'<pre>';
//         print_r($data);
//         echo'</pre>';
        
        
        return view('admin.leaverequests', compact('data'));
    }
    
    
    
