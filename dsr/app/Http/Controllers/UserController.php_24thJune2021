    private function getUserLeaveQuota($user_id){
        
        global $user;
        $user = User::findOrFail($user_id);
        
        $forMonth = date('m', strtotime($user->date_allotted));
        $forYear = date('Y', strtotime($user->date_allotted));
        
        global $allMonthsInsession;
        $allMonthsInsession = [];
        if($forMonth<=6){
            $allMonthsInsession[] = "{$forYear}-01";
            $allMonthsInsession[] = "{$forYear}-02";
            $allMonthsInsession[] = "{$forYear}-03";
            $allMonthsInsession[] = "{$forYear}-04";
            $allMonthsInsession[] = "{$forYear}-05";
            $allMonthsInsession[] = "{$forYear}-06";
        }else{
            $allMonthsInsession[] = "{$forYear}-07";
            $allMonthsInsession[] = "{$forYear}-08";
            $allMonthsInsession[] = "{$forYear}-09";
            $allMonthsInsession[] = "{$forYear}-10";
            $allMonthsInsession[] = "{$forYear}-11";
            $allMonthsInsession[] = "{$forYear}-12";
        }
        
        $userLeaves = Leaves::where( function($query) {
            global $user;
            $query = $query->where('user_id', '=', $user->id);
            $query = $query->where('status', '=', 2);
            $query = $query->where('leave_category_id', '!=', 3);
            return $query;
        })->where( function($query) {
            global $allMonthsInsession;
            foreach($allMonthsInsession as $aMonth){
                $query = $query->orWhere('leave_from', 'LIKE', "$aMonth%");
                $query = $query->orWhere('leave_to', 'LIKE', "$aMonth%");
            }
            return $query;
        })->get();
        
        $userLeaveHistory = [];
        $userLeaveHistory['totalAllotted'] = $user->leaves_allotted + $user->leaves_forward + $user->other_leaves_allotted;
        $userLeaveHistory['leaveTaken'] = 0;
        
        $userLeaveHistory['prePercent'] = 0;
        $userLeaveHistory['postPercent'] = 0;
        $userLeaveHistory['leaveType'][0] = 0;
        $userLeaveHistory['leaveType'][1] = 0;
        
        foreach($userLeaves as $uL){
            
            $YmFrom = date('Y-m', strtotime($uL->leave_from));
            $YmTo = date('Y-m', strtotime($uL->leave_to));
            
            if($YmFrom == $YmTo)
            {
                $userLeaveHistory['leaveTaken']+= $uL->no_working_days;
                if(isset($userLeaveHistory['leaveType'][$uL->leave_type])){
                    $userLeaveHistory['leaveType'][$uL->leave_type]+= $uL->no_working_days;
                }else{
                    $userLeaveHistory['leaveType'][$uL->leave_type] = $uL->no_working_days;
                }
            }
            else
            {
                $allDates = $this->dateRange( $uL->leave_from, $uL->leave_to);
                $workingDaysInLeaveApp = $uL->no_working_days;
                
                foreach($allDates as $aDay){
                    if (!in_array(date('Y-m', strtotime($aDay)), $allMonthsInsession)){
                        
                        if('Sun' !== date('D', strtotime($aDay))){
                            $workingDaysInLeaveApp--;
                        }
                    }
                }
                
                $userLeaveHistory['leaveTaken']+= $workingDaysInLeaveApp;
                if(isset($userLeaveHistory['leaveType'][$uL->leave_type])){
                    $userLeaveHistory['leaveType'][$uL->leave_type]+= $workingDaysInLeaveApp;
                }else{
                    $userLeaveHistory['leaveType'][$uL->leave_type] = $workingDaysInLeaveApp;
                }
            }
            
            
        }
        
        $userLeaveHistory['leaveBalance'] = $userLeaveHistory['totalAllotted'] - $userLeaveHistory['leaveTaken'];
        
        if($userLeaveHistory['leaveTaken']>0){
            if(isset($userLeaveHistory['leaveType'][1])){
                $userLeaveHistory['prePercent'] = round(($userLeaveHistory['leaveType'][1] * 100) / $userLeaveHistory['leaveTaken']);
            }
            if(isset($userLeaveHistory['leaveType'][0])){
                $userLeaveHistory['postPercent'] = round(($userLeaveHistory['leaveType'][0] * 100) / $userLeaveHistory['leaveTaken']);
            }
        }
        
        return $userLeaveHistory;
        
    }
    
    
