    public function saveleave(Request $request){
        $userInput = $request->all();

        $this->validate($request, [
            'leave_from' => 'required',
            'leave_to' => 'required',
            'no_working_days' => 'required',
            'reason' => 'required',
        ]);

        
        $user = Auth::user();
        
        $oldData = array();
        $oldData['original'] = array();
        $oldData['updated'] = array();
        
        if(isset($userInput['leave_id']) && $userInput['leave_id']>0){
            $leave = Leaves::findOrFail($userInput['leave_id']);
            
            $oldData['original']['leave_from'] = $leave->leave_from;
            $oldData['original']['leave_to'] = $leave->leave_to;
            $oldData['original']['no_working_days'] = $leave->no_working_days;
            $oldData['original']['reason'] = $leave->reason;
            $oldData['original']['leave_category_id'] = $leave->leave_category_id;
            
        }else{
            $leave = new Leaves();
            $leave->user_id = $user->id;
        }
       
        $leave->leave_from = $userInput['leave_from'];
        $leave->leave_to = $userInput['leave_to'];
        $leave->no_working_days = $userInput['no_working_days'];
        $leave->reason = $userInput['reason'];
        $leave->leave_category_id = $userInput['leave_category_id'];

        $today = strtotime(date('Y-m-d'));
        $leave_from = strtotime($userInput['leave_from']);
        
        if($today > $leave_from){
            $leave->leave_type = 0;
        }
        
        $leave->save();

        
        if($leave->id > 0){
            if(!isset($userInput['leave_id'])){
                foreach($userInput['managers'] as $manager_id){ 
                    $leave_approve = new Leave_approval();
                    $leave_approve->leave_id = $leave->id;
                    $leave_approve->manager_id = $manager_id;
                    $leave_approve->save();
                }
            }else{
                
                $oldData['updated']['leave_from'] = $leave->leave_from;
                $oldData['updated']['leave_to'] = $leave->leave_to;
                $oldData['updated']['no_working_days'] = $leave->no_working_days;
                $oldData['updated']['reason'] = $leave->reason;
                $oldData['updated']['leave_category_id'] = $leave->leave_category_id;
                
                
                //if(serialize($oldData['original'])!=serialize($oldData['updated'])){
                    
                    $leave_approve = Leave_approval::where('leave_id','=', $userInput['leave_id'])->get();
                    
                    foreach($leave_approve as $leave_app){ 
                        $leaveAp = Leave_approval::findOrFail($leave_app['id']);
                        $leaveAp->approved = 0;
                        $leaveAp->save();
                    }
                    
                    $leave1 = Leaves::findOrFail($userInput['leave_id']);
                    $leave1->status = 0;
                    $leave1->save();
                    

                    $leave_revision = new leaverevision();
                    $leave_revision->leave_id = $userInput['leave_id'];
                    $leave_revision->differences = serialize($oldData);
                    $leave_revision->save();
                   
                //}
                   
            }
        }
        return redirect('/user/leaves');
    }
    
    
    
    public function savedsr(Request $request){
        
        $userInput = $request->all();
        
                
        $requiredData = [];
        foreach($userInput['project'] as $k => $p){
            $requiredData["project[$k][hours_worked]"] = 'required';
        }
        
        /*
        $this->validate($request, [
            'hours_worked' => 'required',
        ]);
        */

        foreach($userInput['project'] as $aProject){
            
            $details = $aProject;
            
            unset($details['project_id']);
            unset($details['hours_worked']);
            unset($details['min_worked']);
            unset($details['_token']);
            
            //
            $user = Auth::user();
            $dsr = new Dsr();
            
            $dsr->user_id = $user->id;
            $dsr->project_id = $aProject['project_id'];
            $totalMinutes = 0;
            if($aProject['hours_worked'] > 0){
                $totalMinutes = $totalMinutes + ($aProject['hours_worked'] * 60);
            }
            if($aProject['min_worked'] > 0){
                $totalMinutes = $totalMinutes + $aProject['min_worked'];
            }
            $dsr->minutes = $totalMinutes;
            
            $dsr->subject = $aProject['subject'];
            
            $dsr->details = serialize($details);
            
             
            $dsr->save();
        }
        
        return redirect('/user/listdsr');
    }
    
    
    public function leaves(Request $request, $id=''){
    
        $user = Auth::user();

        if(!isset($id) || $id==''){
            $id = $user->id;
        }
        
        $requestData = [];
        $requestData['fromDate'] = isset($request->fromDate) ? $request->fromDate : date('Y-m-d', strtotime("-30 days"));
        $requestData['toDate'] = isset($request->toDate) ? $request->toDate : date('Y-m-d')." 12:59:59";
        
        $leavesObj = Leaves::with('approval','leave_category','managerAppproval')->where('user_id','=',$id);

           /* 
        if($requestData['fromDate']!=null){
            $leavesObj = $leavesObj->where('created_at', '>=', $requestData['fromDate']);
        }
        
        if($requestData['toDate']!=null){
            $leavesObj = $leavesObj->where('created_at', '<=', $requestData['toDate']);
        }
        */
        
        $leavesObj = $leavesObj->orderBy('created_at','desc')->get();
        
        
        $data = [];
        
        foreach($leavesObj as $k => $aLeave){
            
            $data[$k]['id'] = $aLeave->id;
            $data[$k]['created_at'] = date('F j, Y, g:i a', strtotime($aLeave->created_at));
            $data[$k]['leave_from'] = date('F j, Y', strtotime($aLeave->leave_from));
            $data[$k]['leave_to'] = date('F j, Y', strtotime($aLeave->leave_to));
            $data[$k]['no_working_days'] = $aLeave->no_working_days;
            
            
            switch ($aLeave->status) {
                case 0:
                    $data[$k]['status'] = 'Pending';
                    break;
                case 1:
                    $data[$k]['status'] = 'In Process';
                    break;
                case 2:
                    $data[$k]['status'] = 'Approved';
                    break;
                case 3:
                    $data[$k]['status'] = 'Rejected';
                    break;
                case 4:
                    $data[$k]['status'] = 'Cancelled';
                    break;
                default:
                    $data[$k]['status'] = 'Pending';
            }
            
            $data[$k]['status_key'] = $aLeave->status;
            $data[$k]['category'] = $aLeave->leave_category->category_name;
            $data[$k]['type'] = $aLeave->leave_type > 0 ? 'Pre' : 'Post';
            
            
            $data[$k]['remark'] = '';
            foreach($aLeave->approval as $k2 => $app){
                
                $projectManager = $leavesObj[$k]->managerAppproval[$k2];
                
                switch ($app->approved) {
                    case 0:
                        //$data[$k]['remark'] = 'Pending';
                        $data[$k]['remark'] = '';
                        break;
                    case 1:
                        //$data[$k]['remark'] = 'In Process';
                        $data[$k]['remark'] = '';
                        break;
                    case 2:
                        $data[$k]['remark'].= "By {$projectManager->first_name} {$projectManager->last_name} (Approved)<br>";
                        break;
                    case 3:
                        $data[$k]['remark'].= "By {$projectManager->first_name} {$projectManager->last_name} (Rejected)<br>";
                        break;
                    case 4:
                        $data[$k]['remark'].= "By {$projectManager->first_name} {$projectManager->last_name} (Cancelled)<br>";
                        break;
                    default:
                        $data[$k]['remark'] = 'Pending';
                }
            }
            
            $data[$k]['id'] = $aLeave->id;
        }
        
        //dd($data);
        
        return view('user.leaves', compact('data','requestData'));
    }

    
