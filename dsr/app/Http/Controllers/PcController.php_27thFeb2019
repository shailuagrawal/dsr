            $request->file('driver_file2')->move('drivers/'.$driverFolder, $driver_file2);
        }
        if ($request->file('driver_file3')!==null && $request->file('driver_file3')->isValid()) {
            $driver_file3 = 'PC_'.$request->machine_no.'_driver3.'.$request->file('driver_file3')->extension();
            $request->file('driver_file3')->move('drivers/'.$driverFolder, $driver_file3);
        }
        $pc->machine_no = $request->machine_no;
        $pc->machine_name = $request->machine_name;
        $pc->purchase_date = $request->purchase_date;
        $pc->machine_location = $request->machine_location;
        $pc->machine_status = $request->machine_status;
        $pc->processor_info = $request->processor_info;
        $pc->motherboard_info = $request->motherboard_info;
        $pc->ram_total = $request->ram_total;
        $pc->ram_slot1 = $request->ram_slot1;
        $pc->ram_slot2 = $request->ram_slot2;
        $pc->ram_type = $request->ram_type;
        $pc->harddisk_size = $request->harddisk_size;
        $pc->harddisk_partition = $request->harddisk_partition;
        $pc->monitor_info = $request->monitor_info;
        $pc->comment = $request->comment;
        $pc->description_system_driver = $request->description_system_driver;
        
        
        
        $pc->save();
        
        return redirect(Route('pcs.index'));
        
    }

