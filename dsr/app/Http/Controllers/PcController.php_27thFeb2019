    public function srbrowser(Request $request)
    {
        
        $requestData = [];
        $requestData['fromDate'] = isset($request->fromDate) ? $request->fromDate : date('Y-m-d', strtotime("-30 days"));
        $requestData['toDate'] = isset($request->toDate) ? $request->toDate : date('Y-m-d')." 24:59:59";
        
        $user = Auth::user();

        $srHistory = Systemrequest::with('forPc','requestedBy');
        
        
        if($requestData['fromDate']!=null){
            $srHistory = $srHistory->where('created_at', '>=', $requestData['fromDate']);
        }
        
        if($requestData['toDate']!=null){
            $srHistory = $srHistory->where('created_at', '<=', $requestData['toDate']);
        }
        
        $srHistory = $srHistory->orderby('created_at', 'desc')->get();
        
        
        return view('admin.srbrowser', compact('pcs', 'srHistory','requestData'));
    }
    
    
    
    public function storesr(Request $request)
    {
        $user = Auth::user();
        
        $this->validate($request, [
            'pc_id' => 'required',
            'location' => 'required',
            'request_area' => 'required',
        ]);

        
        $sr = new Systemrequest();
        
        $sr->pc_id = $request->pc_id;
        $sr->location = $request->location;
        $sr->request_area = $request->request_area;
        $sr->detail = $request->detail;
        $sr->verbally_notified_to = $request->verbally_notified_to;
        $sr->user_id = $user->id;
        $sr->save();
        
        return redirect('srrequest/history');
    }
    
    
    
