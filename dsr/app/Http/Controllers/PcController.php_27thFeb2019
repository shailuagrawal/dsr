    /**
     * Display a listing of the resource.
     *
     * @return \Illuminate\Http\Response
     */
    public function index()
    {
        //
        $pcs = Pc::all();
        
        $reports = [];
        foreach($pcs as $pc){
            $reports['status'][trim($pc['machine_status'])][] = $pc;
            $reports['machine_location'][trim($pc['machine_location'])][] = $pc;
            
        }
        
                
        
        $info = [];
        $info['totalPcs'] = Pc::all()->count();
        $info['machinesWorking'] = Pc::where('machine_status', '=', 'Working')->count();
        $info['UnderRepairing'] = Pc::where('machine_status', '=', 'Under Repairing')->count();
        
        $heading = "Total PCs ({$info['totalPcs']})";
        $subheading = "List of Working PCs({$info['machinesWorking']}) and Under Repairing PCs({$info['UnderRepairing']})";
        return view('admin.pcs', compact('pcs','heading','subheading','reports'));
    }

